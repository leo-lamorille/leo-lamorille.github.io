---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
    title?: string;
    description?: string;
    image?: string; // image d'aperçu (1200 × 630), chemin dans public/
}

const {
    title = `${site.name} — ${site.role}`,
    description = site.description,
    image = "/og-image.png",
} = Astro.props;

// Les aperçus de liens exigent des URL absolues : on s'appuie sur `site`
// (astro.config.mjs). Sans `site`, on retombe sur l'URL de la requête.
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base);
const imageURL = new URL(image, base);
---

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0f0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Aperçu des liens (WhatsApp, LinkedIn, Slack, Discord, iMessage…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role} à ${site.city}`} />

    <!-- X / Twitter : grande image -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Indique que le JS est dispo : sans JS, la nav mobile reste visible -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
</head>
<body>
<a class="skip-link" href="#main">Aller au contenu</a>
<Header />
<main id="main">
    <slot />
</main>
<Footer />

<script>
    // Apparition des éléments [data-reveal] quand ils entrent dans l'écran
    const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => observer.observe(el));
    }
</script>
</body>
</html>