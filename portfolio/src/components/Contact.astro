---
import Button from "./ui/Button.astro";
import { site, socials, contact } from "../data/site";

const linkedin = socials.find((s) => s.label === "LinkedIn");
---

<section id="contact" class="container contact" aria-labelledby="contact-title">
    <div class="contact__card" data-reveal>
        <span class="contact__num" aria-hidden="true">04</span>
        <div class="contact__text">
            <span class="contact__eyebrow">04 — Contact</span>
            <h2 id="contact-title" class="scroll-fill">
                {contact.title} <span class="text-accent">{contact.titleAccent}</span>
            </h2>
            <p class="contact__lead">{contact.text}</p>
            <p class="contact__meta">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
                </svg>
                Basé à {site.city}
            </p>
        </div>

        <div class="contact__actions">
            <!-- E-mail : lien mailto + bouton de copie -->
            <div class="email" data-email>
                <a class="email__link" href={`mailto:${site.email}`}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                    </svg>
                    <span class="email__address">{site.email}</span>
                </a>
                <button class="email__copy" type="button" data-copy={site.email} aria-label="Copier l'adresse e-mail">
                    <svg class="icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
                    </svg>
                    <svg class="icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                </button>
            </div>
            <!-- Annonce pour les lecteurs d'écran ; visuellement, l'icône passe en coche -->
            <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

            {
                linkedin && (
                            <Button href={linkedin.href} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">
                                Me contacter sur LinkedIn
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M7 17 17 7" /><path d="M8 7h9v9" />
                                </svg>
                            </Button>
                )
            }
        </div>
    </div>
</section>

<script>
    const wrapper = document.querySelector<HTMLElement>("[data-email]");
    const button = wrapper?.querySelector<HTMLButtonElement>("[data-copy]");
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    let timer: number | undefined;

    button?.addEventListener("click", async () => {
        const value = button.dataset.copy ?? "";
        try {
            await navigator.clipboard.writeText(value);
            wrapper?.classList.add("is-copied");
            if (status) status.textContent = "Adresse copiée !";
        } catch {
            if (status) status.textContent = "Copie impossible, sélectionne l'adresse à la main.";
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
            wrapper?.classList.remove("is-copied");
            if (status) status.textContent = "";
        }, 2200);
    });
</script>

<style>
    /* ---------- Mobile ---------- */
    .contact {
        padding-block: var(--section-pt) 64px;
    }

    .contact__card {
        position: relative;
        isolation: isolate;
        overflow: clip;
        display: flex;
        flex-direction: column;
        gap: 28px;
        padding: 28px 22px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
    }

    .contact__text {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .contact__eyebrow {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-accent);
    }

    h2 {
        font-size: clamp(30px, 8vw, 60px);
        line-height: 1.06;
        letter-spacing: -0.035em;
    }

    .contact__lead {
        max-width: 520px;
        font-size: 16px;
        line-height: 1.6;
        color: var(--color-muted);
    }

    .contact__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-muted);
    }

    .contact__meta svg {
        color: var(--color-accent);
    }

    /* Boutons pleine largeur */
    .contact__actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }

    /* --- Bouton e-mail en deux parties : lien + copie --- */
    .email {
        display: flex;
        min-height: 52px;
        border-radius: 12px;
        background: var(--color-accent);
        color: var(--color-on-accent);
        overflow: hidden;
    }

    .email__link {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 16px;
        font-size: 16px;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

    .email__link svg {
        flex-shrink: 0;
    }

    .email__address {
        overflow-wrap: anywhere;
    }

    .email__copy {
        position: relative;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        border: 0;
        border-left: 1px solid color-mix(in srgb, var(--color-on-accent) 22%, transparent);
        background: none;
        color: inherit;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .email__copy:focus-visible,
    .email__link:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: -4px;
    }

    .icon-check {
        position: absolute;
        opacity: 0;
        transform: scale(0.6);
        transition:
                opacity 0.2s ease,
                transform 0.25s var(--ease-out);
    }

    .icon-copy {
        transition:
                opacity 0.2s ease,
                transform 0.25s var(--ease-out);
    }

    .email.is-copied .icon-copy {
        opacity: 0;
        transform: scale(0.6);
    }

    .email.is-copied .icon-check {
        opacity: 1;
        transform: none;
    }

    @media (hover: hover) {
        .email__link:hover,
        .email__copy:hover {
            background: color-mix(in srgb, var(--color-accent) 88%, white);
        }
    }

    /* Grand numéro en contour dans le coin de la carte */
    .contact__num {
        position: absolute;
        top: -0.12em;
        right: 0.05em;
        z-index: -1;
        font-family: var(--font-display);
        font-size: clamp(120px, 30vw, 320px);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.05em;
        color: transparent;
        -webkit-text-stroke: 1px color-mix(in srgb, var(--color-accent) 22%, transparent);
        pointer-events: none;
        user-select: none;
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            /* La section "s'approche" en entrant dans l'écran */
            .contact {
                animation-name: contact-zoom;
                animation-timing-function: linear;
                animation-fill-mode: both;
                animation-timeline: view();
                animation-range: entry 0% cover 40%;
            }

            /* Le numéro descend dans la carte pendant le scroll */
            .contact__num {
                animation-name: contact-num;
                animation-timing-function: linear;
                animation-fill-mode: both;
                animation-timeline: view();
            }
        }
    }

    @keyframes contact-zoom {
        from {
            scale: 0.92;
        }
    }

    @keyframes contact-num {
        from {
            translate: 0 -30%;
        }
        to {
            translate: 0 40%;
        }
    }

    /* ---------- Tablette + ---------- */
    @media (min-width: 768px) {
        .contact {
            padding-block: var(--section-pt) 112px;
        }

        .contact__card {
            gap: 36px;
            padding: 56px;
            border-radius: var(--radius-xl);
        }

        .contact__text {
            gap: 16px;
        }

        .contact__eyebrow {
            font-size: 14px;
        }

        .contact__lead {
            font-size: 18px;
        }

        .contact__actions {
            align-items: flex-start;
        }

        .email {
            min-width: 360px;
        }
    }

    /* ---------- Desktop : texte à gauche, actions à droite ---------- */
    @media (min-width: 1024px) {
        .contact__card {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
            gap: 48px;
            padding: 72px;
        }

        .contact__text {
            flex: 1 1 auto;
            max-width: 600px;
        }

        .contact__actions {
            flex-shrink: 0;
            align-items: stretch;
            width: 380px;
        }

        .email {
            min-width: 0;
        }
    }
</style>