---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import CodeWindow from "./CodeWindow.astro";
import { site, socials } from "../data/site";
import avatar from "../assets/avatar.jpg";
---

<div class="hero-wrap">
    <!-- Couches de décor, déplacées à des vitesses différentes au scroll -->
    <div class="hero__bg" aria-hidden="true">
        <div class="hero__grid"></div>
        <div class="hero__glow"></div>
    </div>

    <section class="container hero" aria-labelledby="hero-title">
        <div class="hero__content">
            <div class="intro enter">
                <Image
                        class="intro__avatar"
                        src={avatar}
                        alt={`Portrait de ${site.name}`}
                        widths={[112, 144, 216]}
                        sizes="(min-width: 768px) 72px, 56px"
                        loading="eager"
                        fetchpriority="high"
                />
                <div class="intro__text">
                    <p class="intro__name">{site.name}</p>
                    {
                        site.available ? (
                                <p class="intro__status">
                                    <span class="intro__dot" aria-hidden="true" />
                                    {site.availabilityLabel}
                                </p>
                        ) : (
                                <p class="intro__status">{site.role}</p>
                        )
                    }
                </div>
            </div>

            <h1 id="hero-title" class="enter" style="--d: 80">
                Je conçois et développe des applications web <span class="text-accent">de bout en bout.</span>
            </h1>

            <p class="hero__lead enter" style="--d: 160">
                Ingénieur de développement fullstack, je transforme des besoins métier en produits fiables, de
                l'architecture back-end jusqu'à l'interface.
            </p>

            <div class="hero__actions enter" style="--d: 240">
                <Button href="/projects" size="lg">
                    Voir mes projets
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
                    </svg>
                </Button>
                <Button href={site.cvUrl} variant="secondary" size="lg" download>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" />
                    </svg>
                    Télécharger mon CV
                </Button>
            </div>

            <ul class="socials enter" style="--d: 320">
                {
                    socials.map((s) => (
                            <li>
                                <a href={s.href} target="_blank" rel="noopener noreferrer">
                                    {s.label} ↗
                                </a>
                            </li>
                    ))
                }
            </ul>
        </div>

        <div class="hero__visual enter" style="--d: 300">
            <CodeWindow />
        </div>
    </section>
</div>

<style>
    /* ---------- Mobile : une colonne ---------- */
    /* ---------- Parallaxe : décor ---------- */
    .hero-wrap {
        position: relative;
        isolation: isolate;
        overflow: clip;
    }

    .hero__bg {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
    }

    /* Grille de points, estompée sur les bords */
    .hero__grid {
        position: absolute;
        inset: -10% 0 -40%;
        background-image: radial-gradient(
                color-mix(in srgb, var(--color-text) 16%, transparent) 1px,
                transparent 1.6px
        );
        background-size: 28px 28px;
        -webkit-mask-image: radial-gradient(ellipse 75% 55% at 70% 30%, #000 15%, transparent 75%);
        mask-image: radial-gradient(ellipse 75% 55% at 70% 30%, #000 15%, transparent 75%);
    }

    /* Halo menthe derrière la fenêtre de code */
    .hero__glow {
        position: absolute;
        top: 8%;
        right: -160px;
        width: 560px;
        height: 560px;
        border-radius: 50%;
        background: radial-gradient(
                circle,
                color-mix(in srgb, var(--color-accent) 20%, transparent),
                transparent 65%
        );
        filter: blur(24px);
    }

    @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
            /* Propriétés séparées : le minificateur casserait le raccourci "animation" */
            .hero__grid,
            .hero__glow {
                animation-timing-function: linear;
                animation-fill-mode: both;
                animation-timeline: scroll(root block);
                animation-range: 0 100vh;
            }

            /* La grille descend : elle paraît plus lointaine que le contenu */
            .hero__grid {
                animation-name: parallax-grid;
            }

            /* Le halo descend encore plus et grossit */
            .hero__glow {
                animation-name: parallax-glow;
            }
        }
    }

    @keyframes parallax-grid {
        to {
            translate: 0 180px;
        }
    }

    @keyframes parallax-glow {
        to {
            translate: 0 280px;
            scale: 1.25;
            opacity: 0.4;
        }
    }

    /* ---------- Mobile : une colonne ---------- */
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 40px;
        padding-block: 40px 48px;
    }

    .hero__content {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

    .hero__visual {
        min-width: 0;
    }

    /* Avatar + nom + disponibilité */
    .intro {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .intro :global(.intro__avatar) {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: var(--radius-full);
        object-fit: cover;
        /* anneau menthe détaché du fond */
        box-shadow:
                0 0 0 3px var(--color-bg),
                0 0 0 4px var(--color-accent);
    }

    .intro__text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .intro__name {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 600;
    }

    .intro__status {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 13px;
        color: var(--color-muted);
    }

    .intro__dot {
        position: relative;
        top: -1px;
        flex-shrink: 0;
        width: 8px;
        height: 8px;
        border-radius: var(--radius-full);
        background: var(--color-accent);
    }

    .intro__dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--color-accent);
        animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes ping {
        75%,
        100% {
            transform: scale(2.4);
            opacity: 0;
        }
    }

    h1 {
        font-size: clamp(34px, 9vw, 72px);
        line-height: 1.06;
        letter-spacing: -0.035em;
    }

    .hero__lead {
        max-width: 560px;
        font-size: 17px;
        line-height: 1.6;
        color: var(--color-muted);
    }

    /* Boutons pleine largeur, empilés */
    .hero__actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0 24px;
        margin: 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--color-muted);
    }

    .socials a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
    }

    /* La flèche du bouton principal glisse au survol */
    .hero__actions :global(.btn--primary svg) {
        transition: transform 0.25s var(--ease-out);
    }

    @media (hover: hover) {
        .socials a:hover {
            color: var(--color-accent);
        }
        .hero__actions :global(.btn--primary:hover svg) {
            transform: translateX(4px);
        }
    }

    /* ---------- Grand mobile + : boutons côte à côte ---------- */
    @media (min-width: 640px) {
        .hero__actions {
            display: flex;
            flex-wrap: wrap;
        }
    }

    /* ---------- Tablette + ---------- */
    @media (min-width: 768px) {
        .hero {
            gap: 48px;
            padding-block: 72px 64px;
        }

        .hero__content {
            gap: 28px;
        }

        .intro {
            gap: 16px;
        }

        .intro :global(.intro__avatar) {
            width: 64px;
            height: 64px;
        }

        .intro__name {
            font-size: 17px;
        }

        .intro__status {
            font-size: 14px;
        }

        .hero__lead {
            font-size: 19px;
        }
    }

    /* ---------- Desktop : deux colonnes ---------- */
    @media (min-width: 1024px) {
        .hero {
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
            align-items: center;
            gap: 56px;
            padding-block: 96px 72px;
        }
    }

    /* ---------- Desktop : parallaxe du contenu ----------
       Le texte remonte un peu et s'estompe, la fenêtre de code remonte
       plus vite : les deux colonnes se décalent en quittant l'écran. */
    @supports (animation-timeline: scroll()) {
        @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
            .hero__content,
            .hero__visual :global(.code) {
                animation-timing-function: linear;
                animation-fill-mode: both;
                animation-timeline: scroll(root block);
                animation-range: 0 80vh;
            }

            .hero__content {
                animation-name: parallax-text;
            }

            .hero__visual :global(.code) {
                animation-name: parallax-code;
            }
        }
    }

    @keyframes parallax-text {
        to {
            translate: 0 -60px;
            opacity: 0.25;
        }
    }

    @keyframes parallax-code {
        to {
            translate: 0 -160px;
        }
    }
</style>