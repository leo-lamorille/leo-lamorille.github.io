---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectSection from "../components/projects/ProjectSection.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import { site } from "../data/site";
import { projects, projectsPage } from "../data/projects";
---

<BaseLayout title={`${projectsPage.title} — ${site.name}`} description={projectsPage.lead}>
    <div class="page-head-wrap">
        <div class="page-head__grid" aria-hidden="true"></div>

        <header class="container page-head">
            <a class="page-head__back enter" href="/">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5" /><path d="m11 18-6-6 6-6" />
                </svg>
                Accueil
            </a>
            <h1 class="enter" style="--d: 80">{projectsPage.title}</h1>
            <p class="page-head__lead enter" style="--d: 160">{projectsPage.lead}</p>
        </header>
    </div>

    <div class="container projects">
        {projects.map((project) => <ProjectSection project={project} />)}
    </div>

    <Lightbox />
</BaseLayout>

<style>
    /* ---------- En-tête de page ---------- */
    .page-head-wrap {
        position: relative;
        isolation: isolate;
        overflow: clip;
        border-bottom: 1px solid var(--color-border);
    }

    /* Même grille de points que le hero de l'accueil */
    .page-head__grid {
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image: radial-gradient(
                color-mix(in srgb, var(--color-text) 16%, transparent) 1px,
                transparent 1.6px
        );
        background-size: 28px 28px;
        -webkit-mask-image: radial-gradient(ellipse 70% 90% at 80% 0%, #000 10%, transparent 70%);
        mask-image: radial-gradient(ellipse 70% 90% at 80% 0%, #000 10%, transparent 70%);
    }

    .page-head {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-block: 40px 48px;
    }

    .page-head__back {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-muted);
    }

    @media (hover: hover) {
        .page-head__back:hover {
            color: var(--color-accent);
        }
    }

    h1 {
        font-size: clamp(40px, 10vw, 88px);
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .page-head__lead {
        max-width: 620px;
        font-size: 17px;
        line-height: 1.6;
        color: var(--color-muted);
    }

    /* ---------- Liste des projets ---------- */
    .projects {
        display: flex;
        flex-direction: column;
        gap: 96px;
        padding-block: 56px 96px;
    }

    @media (min-width: 768px) {
        .page-head {
            gap: 20px;
            padding-block: 64px 72px;
        }

        .page-head__lead {
            font-size: 19px;
        }

        .projects {
            gap: 144px;
            padding-block: 80px 128px;
        }
    }
</style>